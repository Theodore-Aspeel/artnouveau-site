{
  "name": "artnouveau-editorial-site",
  "version": "0.1.0",
  "description": "Vanilla HTML/CSS/JS editorial site about Art Nouveau and Art Deco in Europe, published as a deterministic static build.",
  "private": true,
  "keywords": [
    "art-nouveau",
    "art-deco",
    "editorial-site",
    "static-site",
    "vanilla-js"
  ],
  "author": "Christophe Aspel",
  "license": "MIT",
  "scripts": {
    "editor": "python -m tools.editorial_manager editor",
    "validate": "node scripts/validate-content.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "test:node": "node --test tests/*.mjs",
    "test:publication-filter": "node --test tests/publication-policy.mjs",
    "test:python": "python -m unittest discover tests",
    "test": "npm run build && npm run test:node && npm run test:python",
    "rights:check": "python -m tools.editorial_manager media-rights-check",
    "quality": "npm run validate && npm run rights:check && npm test",
    "spike:coilliot:render": "remotion render video-spikes/maison-coilliot/index.ts MaisonCoilliotStandardSpike video-spikes/maison-coilliot/output/maison-coilliot-standard-spike-720x1280.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "spike:coilliot:stills": "node video-spikes/maison-coilliot/render-stills.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.526",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remotion": "^4.0.526",
    "sharp": "^0.34.5"
  }
}
