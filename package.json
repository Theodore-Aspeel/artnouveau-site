{
  "name": "artnouveau-editorial-site",
  "version": "0.1.0",
  "description": "Vanilla HTML/CSS/JS editorial site about Art Nouveau and Art Deco in Europe, published as a deterministic static build.",
  "private": true,
  "keywords": [
    "art-nouveau",
    "art-deco",
    "editorial-site",
    "static-site",
    "vanilla-js"
  ],
  "author": "Christophe Aspel",
  "license": "MIT",
  "scripts": {
    "editor": "python -m tools.editorial_manager editor",
    "validate": "node scripts/validate-content.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "preview:private": "node scripts/preview.mjs",
    "test:e2e": "playwright test tests/web/e2e.spec.mjs",
    "test:a11y": "playwright test tests/web/accessibility.spec.mjs --project=chromium-desktop",
    "test:lighthouse": "lhci autorun --config=./lighthouserc.json",
    "qa:web": "playwright test tests/web",
    "test:node": "node --test tests/*.mjs",
    "test:publication-filter": "node --test tests/publication-policy.mjs",
    "test:python": "python -m unittest discover tests",
    "test": "npm run build && npm run test:node && npm run test:python",
    "rights:check": "python -m tools.editorial_manager media-rights-check",
    "quality": "npm run validate && npm run rights:check && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "sharp": "^0.34.5"
  }
}
